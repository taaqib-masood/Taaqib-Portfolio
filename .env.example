# ──────────────────────────────────────────────────────────
# REQUIRED: Groq API key for the AI agent (defaults to openai/gpt-oss-20b)
# Get yours at: https://console.groq.com/keys
# ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: Resend API key. Powers BOTH the contact form and the
# "Want Taaqib to follow up?" transcript email. Without it both return 503 and
# nothing is sent. Get yours at: https://resend.com/api-keys
# Verify it with:  RESEND_API_KEY=re_xxx node scripts/check-mail.mjs --send
# ──────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# OPTIONAL: the From address. The default, onboarding@resend.dev, is Resend's test
# sender and ONLY delivers to the email address on your Resend account. If you signed
# up with a different email than taaqib.masood@icloud.com, every send fails with a 403
# until you verify a domain and set this, e.g. "Portfolio AI Agent <agent@yourdomain.com>".
# RESEND_FROM=Portfolio AI Agent <onboarding@resend.dev>

# ──────────────────────────────────────────────────────────
# OPTIONAL: GitHub personal access token
# Increases rate limits for get_github_stats tool.
# Without this, the tool uses a cached fallback (569 contributions, 6 repos, 58 stars).
# ──────────────────────────────────────────────────────────
# Optional. A read-only token of the portfolio owner: higher rate limits, and the contribution
# calendar then counts private-repo work too (numbers only), matching the GitHub profile.
GITHUB_TOKEN=optional
